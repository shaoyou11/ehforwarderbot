# Narrow maintenance release: preserve the exact deployed runtime and dependencies.
# Use the full Dockerfile explicitly when testing upstream/runtime upgrades.
FROM ghcr.io/shaoyou11/efb-web-standby@sha256:2e846e87a76707fe11c5826525f55e84b8efb571d07e3ef11f20c11f3ba6c745
USER root
ARG EFB_IMAGE_SOURCE_REF=unknown
ARG EFB_IMAGE_BUILD_TIME=unknown
COPY web-image/control/topic_guard.py /usr/local/lib/python3.11/site-packages/efb_telegram_master/topic_guard.py
COPY web-image/control/topic_guard.py web-image/control/topic_catalog.py web-image/control/sync.py web-image/control/worker.py web-image/control/test_topic_guard.py web-image/control/test_control.py /opt/efb-backend-control/
COPY web-image/control/ /opt/efb-backend-control/
COPY web-image/imessage/*.py /opt/efb-imessage/
RUN test "$(readlink /opt/control)" = /opt/efb-backend-control || ln -s /opt/efb-backend-control /opt/control
# The verified base already contains the routing hook; do not apply it twice.
ENV EFB_IMAGE_SOURCE_REF="${EFB_IMAGE_SOURCE_REF}"
ENV EFB_IMAGE_BUILD_TIME="${EFB_IMAGE_BUILD_TIME}"
LABEL org.opencontainers.image.revision="${EFB_IMAGE_SOURCE_REF}" org.opencontainers.image.created="${EFB_IMAGE_BUILD_TIME}"
USER 10001:10001
RUN python /opt/efb-backend-control/test_topic_guard.py && python /opt/efb-backend-control/test_control.py

RUN python /opt/efb-backend-control/test_binding_review.py

RUN python /opt/efb-backend-control/test_notifications.py
